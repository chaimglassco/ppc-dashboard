# Public navigation only; defaults to the canonical Pipeline origin.
NEXT_PUBLIC_PIPELINE_ORIGIN=

# Server-to-server Pipeline authentication; defaults to the canonical Pipeline origin.
PIPELINE_AUTH_ORIGIN=

# Configure either the OAuth pair or a pre-authorized MCP access token.
SCALE_INSIGHTS_OAUTH_CLIENT_ID=
SCALE_INSIGHTS_OAUTH_CLIENT_SECRET=
SCALE_INSIGHTS_MCP_ACCESS_TOKEN=

# Optional Scale Insights OAuth/MCP overrides.
SCALE_INSIGHTS_OAUTH_SCOPE=
SCALE_INSIGHTS_OAUTH_ISSUER=
SCALE_INSIGHTS_MCP_URL=https://mcp.scaleinsights.com/mcp
